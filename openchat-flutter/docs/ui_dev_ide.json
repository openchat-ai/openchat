{
  "title": "Dev Console",
  "tabs": [
    {"label": "Console", "type": "logs"},
    {"label": "Status", "type": "sdui", "content": {
      "type": "column", "center": true, "children": [
        {"type": "icon", "icon": "code", "size": 48},
        {"type": "text", "content": "Peer: {{peerId}}", "style": {"size": 16}, "pad": 16},
        {"type": "text", "content": "Version: {{appVersion}}", "style": {"size": 13}, "pad": 4},
        {"type": "text", "content": "Logs: {{logCount}} entries", "style": {"size": 13}, "pad": 4}
      ]
    }},
    {"label": "Debug", "type": "sdui", "content": {
      "type": "column", "center": true, "children": [
        {"type": "text", "content": "Send a command below", "style": {"size": 14}, "pad": 16},
        {"type": "text", "content": "ping / diag / test_put / test_list", "style": {"size": 12, "color": "#9E9E9E"}}
      ]
    }}
  ]
}
