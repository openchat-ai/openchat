{
  "version": 1,
  "name": "openchat-experiments",
  "description": "可组合实验：每个实验 = 一个有 I/O 契约的可复用构件。用 compose.mjs 按依赖图拼装。",
  "ioSchema": {
    "Buffer":  "Node.js Buffer",
    "string":  "UTF-8 字符串",
    "number":  "整数",
    "boolean": "true / false",
    "object":  "结构化对象",
    "array":   "数组",
    "function":"async (args) => result",
    "any":     "运行时决定"
  },
  "statusSchema": {
    "closed-loop":   "有真实行为断言，run-all 跑通即代表回归被捕获",
    "skeleton":      "只有结构/存在性检查或无 test 函数；需要补充行为断言或挪走",
    "reference-only": "参考实现，不是可跑实验；不应进 run-all"
  },
  "experiments": [
    {
      "id": "config",
      "file": "1-sdui.mjs",
      "name": "持久化配置",
      "category": "config",
      "pure": true,
      "needsEnv": [],
      "description": "读取 ~/.openchat/config.json，含 providers / current / paths。",
      "inputs": [],
      "outputs": [
        { "name": "config",   "type": "object", "description": "完整 config 对象" },
        { "name": "provider", "type": "string", "description": "当前 provider 名" },
        { "name": "model",    "type": "string", "description": "当前 model" }
      ],
      "deps": [],
      "tags": ["config", "provider", "paths"],
      "status": "closed-loop"
    },
    {
      "id": "agent",
      "file": "2-agent.mjs",
      "name": "LLM 代理 (provider-kit)",
      "category": "llm",
      "pure": false,
