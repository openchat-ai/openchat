      "status": "closed-loop"
    },
    {
      "id": "naming",
      "file": "8-naming.mjs",
      "name": "会话自动命名",
      "category": "chat",
      "pure": false,
      "needsEnv": ["QINIU_ACCESS_KEY", "QINIU_SECRET_KEY"],
