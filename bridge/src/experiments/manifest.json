      "outputs": [
        { "name": "meta", "type": "object", "description": "{ name, userSet, autoNamed, createdAt, updatedAt }" }
      ],
      "deps": ["qiniu"],
      "tags": ["naming", "chat", "auto-name"],
      "status": "closed-loop"
    },
    {
