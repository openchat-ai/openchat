{
  "_meta": {
    "purpose": "固定 10 个 prompt, 每个用 1 个不同类别的 tool, 测工具数量对弱模型选对工具的影响。",
    "repeats": 3,
    "scoring": "toolPick / paramName / paramValue / extraFields / validCall / noToolCall"
  },
  "prompts": [
    {
      "id": "q1",
      "text": "读 src/index.js 这个文件",
      "expect": { "name": "read_file", "args": { "path": "src/index.js" } }
    },
    {
      "id": "q2",
      "text": "搜索项目里所有 TODO 字符串",
      "expect": { "name": "grep", "args": { "pattern": "TODO", "path": "." } }
    },
    {
      "id": "q3",
      "text": "找 createProvider 函数的定义在哪",
      "expect": { "name": "ast_find_refs", "args": { "symbol": "createProvider" } }
    },
    {
      "id": "q4",
      "text": "列出项目的依赖关系",
      "expect": { "name": "dep_graph", "args": {} }
    },
    {
      "id": "q5",
      "text": "git 提交当前修改",
      "expect": { "name": "git_commit", "args": {} }
    },
    {
      "id": "q6",
      "text": "跑一下 lint 检查代码",
      "expect": { "name": "lint_run", "args": {} }
    },
    {
      "id": "q7",
      "text": "把 src/foo.js 里的 bar 全部重命名成 baz",
      "expect": { "name": "ast_rename", "args": { "oldName": "bar", "newName": "baz" } }
    },
    {
      "id": "q8",
      "text": "解析这个 SQL: CREATE TABLE users (id INT PRIMARY KEY, name TEXT)",
      "expect": { "name": "sql_parse", "args": { "sql": "CREATE TABLE users (id INT PRIMARY KEY, name TEXT)" } }
    },
    {
      "id": "q9",
      "text": "连一个 MQTT broker, host 是 test.mosquitto.org, port 1883",
      "expect": { "name": "mqtt_connect", "args": { "host": "test.mosquitto.org", "port": 1883 } }
    },
    {
      "id": "q10",
      "text": "找 createProvider 在哪些文件里被引用了",
      "expect": { "name": "find_refs", "args": { "symbol": "createProvider" } }
    }
  ]
}
