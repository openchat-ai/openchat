{
  "name": "openchat",
  "version": "0.1.0",
  "description": "Decentralized social network + AI residents platform - Bridge CLI",
  "type": "module",
  "main": "src/main.js",
  "bin": {
    "openchat": "./bin/openchat.mjs"
  },
  "engines": {
    "node": ">=20.10.0 <23",
    "npm": ">=10.0.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "scripts": {
    "start": "node src/main.js",
    "start:cli": "node src/main.js --cli",
    "dev": "node --watch src/main.js",
    "dev:cli": "node --watch src/main.js --cli",
    "cli": "node bin/openchat.js",
    "build": "node scripts/build-deploy.js",
    "build:fast": "node scripts/build-deploy.js --skip-archive",
    "clean": "node scripts/clean.js",
    "check": "node scripts/check-syntax.mjs",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint src/ scripts/ --fix",
    "format": "prettier --write \"src/**/*.{js,mjs,json}\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,mjs,json}\" \"scripts/**/*.js\"",
    "test": "node scripts/check-syntax.mjs && node tests-runner.mjs",
    "test:unit": "node --test src/core/__tests__/*.test.js src/p2p/__tests__/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:e2e": "node --test test/e2e/*.test.js",
    "test:voice": "node --test tests/voice-demo.mjs",
    "test:watch": "node scripts/check-syntax.mjs",
    "test:idea": "node --test src/core/__tests__/*.test.js",
    "test:full": "node scripts/check-syntax.mjs",
    "test:contract": "node --test tests/contract/*.test.js",
    "test:llm-judge": "node test-utils/llm-judge.js",
    "test:property": "node test-utils/property-test.js",
    "test:replay": "node test-utils/replay-test.js",
    "test:chaos": "node test-utils/chaos-test.js",
    "test:coverage": "node --test --experimental-test-coverage src/core/__tests__/*.test.js",
    "test:all": "node --test tests-runner.mjs tests/contract/*.js",
    "test:benchmark": "node --test tests/benchmarks/*.js",
    "eval:generalization": "node tools/eval-generalization.mjs",
    "pm2:start": "node --input-type=module -e \"import {createLaunchStrategy,detectBestStrategy} from './src/core/p2r/launch-strategies.js';const s=createLaunchStrategy(detectBestStrategy(),{name:'openchat-bridge',script:'src/main.js'});await s.launch()\"",
    "pm2:stop": "pm2 delete openchat-bridge 2>/dev/null; exit 0",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs openchat-bridge",
    "pm2:reload": "pm2 reload openchat-bridge",
    "demo": "node scripts/demo.mjs",
    "lab": "node src/experiments/tui/tui.mjs",
    "prepare": "husky || true"
  },
  "keywords": [
    "p2p",
    "decentralized",
    "social",
    "ai",
    "bridge",
    "hyperswarm"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "src/",
    "bin/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@jitsi/rnnoise-wasm": "0.2.1",
    "@shiguredo/rnnoise-wasm": "2025.1.5",
    "axios": "1.7.9",
    "chalk": "5.6.2",
    "cors": "2.8.6",
    "dotenv": "17.4.1",
    "express": "^5.2.1",
    "fairy-guardian": "1.1.2",
    "helmet": "^8.2.0",
    "hyperswarm": "4.17.0",
    "joi": "^18.2.1",
    "mathjs": "15.2.0",
    "morgan": "1.10.1",
    "onnxruntime-node": "1.24.3",
    "opusscript": "0.1.1",
    "pino": "10.3.1",
    "provider-kit": "^2.0.6",
    "qiniu": "7.15.2",
    "swagger-ui-express": "5.0.1",
    "uuid": "^14.0.0",
    "ws": "8.16.0",
    "zeromq": "6.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "husky": "9.1.7",
    "prettier": "3.4.2"
  },
  "optionalDependencies": {
    "pm2": "5.4.0",
    "sql.js": "1.10.0"
  }
}
