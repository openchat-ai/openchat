#!/bin/sh
# OpenChat 提交前自动测试

if [ -f ".husky/../scripts/verify-commit.mjs" ]; then
  node scripts/verify-commit.mjs || { echo "❌ verify-commit 未通过"; exit 1; }
fi

echo "🔍 运行提交前检查..."

# Lint 检查
echo "🔍 运行 ESLint..."
(cd bridge && npx eslint src/ --quiet) 2>/dev/null || {
  echo "❌ ESLint 错误，请修复后再提交"
  exit 1
}
echo "✅ ESLint 通过"

# 1. Bridge 语法检查（全部文件）
echo "📦 检查 Bridge 语法..."
(cd bridge && node scripts/check-syntax.mjs) 2>/dev/null || {
  echo "❌ Bridge 语法检查失败"
  exit 1
}
echo "✅ Bridge 语法检查通过"

# 2. 快速语法检查（变更文件）
echo "🧪 检查新增/修改文件的语法..."
git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|mjs)$' | while IFS= read -r f; do
  node --check "$f" 2>/dev/null || { echo "❌ 语法错误: $f"; exit 1; }
done
echo "✅ 语法检查通过"

# 3. Flutter 静态分析（如有 flutter，跳过无 flutter 的环境）
if command -v flutter >/dev/null 2>&1; then
  echo "🦋 运行 flutter analyze..."
  if git diff --cached --name-only --diff-filter=ACM | grep -qE '\.dart$'; then
    (cd openchat-flutter && flutter analyze --no-fatal-infos --no-fatal-warnings) 2>/dev/null || {
      echo "❌ flutter analyze 失败"
      exit 1
    }
    echo "✅ flutter analyze 通过"
  else
    echo "⏭  无 Dart 变更，跳过"
  fi
else
  echo "⏭  未检测到 flutter，跳过（CI 仍会跑）"
fi

echo ""
echo "✅ 所有检查通过！继续提交..."
