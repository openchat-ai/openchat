<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agent Approval Needed"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/tvSheetSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="The agent has a plan. Review and approve."
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/tvSheetDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:background="@color/surface_card"
        android:padding="12dp"
        android:maxLines="20"
        android:scrollbars="vertical"
        android:textColor="@color/bubble_agent_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="20dp"
        android:gravity="end">

        <TextView
            android:id="@+id/btnSheetReject"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="Reject"
            android:textColor="@color/reject_red"
            android:textSize="15sp"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnSheetApprove"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="Approve"
            android:textColor="@color/bubble_user_text"
            android:textSize="15sp"
            android:background="@drawable/bg_send"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>