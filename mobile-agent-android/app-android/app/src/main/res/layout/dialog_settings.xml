<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:contentPadding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LLM Provider"
                    android:textColor="@color/tab_active"
                    android:textSize="14sp"
                    android:paddingBottom="12dp" />

                <EditText
                    android:id="@+id/etProviderBaseUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_provider_base_url"
                    android:inputType="textUri"
                    android:background="@drawable/bg_input" />

                <EditText
                    android:id="@+id/etProviderApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_provider_api_key"
                    android:inputType="textPassword"
                    android:background="@drawable/bg_input" />

                <EditText
                    android:id="@+id/etProviderModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_provider_model"
                    android:inputType="text"
                    android:background="@drawable/bg_input" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerifyProvider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_verify_provider"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.Material3.Button.TonalButton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:contentPadding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GitHub Configuration"
                    android:textColor="@color/tab_active"
                    android:textSize="14sp"
                    android:paddingBottom="12dp" />

                <EditText
                    android:id="@+id/etGithubToken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_github_token"
                    android:inputType="textPassword"
                    android:background="@drawable/bg_input" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="4dp">
                    <EditText
                        android:id="@+id/etGithubOwner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_github_owner"
                        android:background="@drawable/bg_input" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFetchOwners"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        style="@style/Widget.Material3.Button.TonalButton" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="4dp">
                    <EditText
                        android:id="@+id/etGithubRepo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_github_repo"
                        android:background="@drawable/bg_input" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFetchRepos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        style="@style/Widget.Material3.Button.TonalButton" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/etGithubBaseBranch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_github_base_branch"
                        android:background="@drawable/bg_input" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFetchBranches"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        style="@style/Widget.Material3.Button.TonalButton" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="More coming soon ..."
            android:textAlignment="center"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:paddingBottom="24dp" />

    </LinearLayout>
</ScrollView>