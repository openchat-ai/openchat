<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LLM Provider"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/etProviderBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_provider_base_url"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/etProviderApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_provider_api_key"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/etProviderModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_provider_model"
            android:inputType="text" />

        <Button
            android:id="@+id/btnVerifyProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_verify_provider"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GitHub Configuration"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/etGithubToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_github_token"
            android:inputType="textPassword" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etGithubOwner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_github_owner" />
            <Button
                android:id="@+id/btnFetchOwners"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etGithubRepo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_github_repo" />
            <Button
                android:id="@+id/btnFetchRepos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etGithubBaseBranch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_github_base_branch" />
            <Button
                android:id="@+id/btnFetchBranches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>